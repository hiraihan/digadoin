DB_USER=test
DB_PASSWORD=test
DB_SERVER=test
DB_PORT=test
DB_NAME=test
SECRET_KEY=test

# Email Provider Configuration
# Options: "smtp" or "resend"
# Use "resend" for Railway deployment (SMTP is blocked)
EMAIL_PROVIDER=smtp

# SMTP Email Configuration (for local development)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@digadoin.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Digadoin

# Resend Configuration (for Railway deployment)
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

FRONTEND_URL=http://localhost:3000
